# Copy to .env and fill in. Bun loads .env from the project directory automatically.

# Required ---------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# The supergroup with Topics enabled (negative number, e.g. -100xxxxxxxxxx).
# The bot must be an admin with "Manage Topics".
TG_CHAT_ID=
# Telegram user ids allowed to drive sessions, comma separated
TG_ALLOWED_USERS=
# Working directory for new Claude sessions (CLAUDE.md / memory are picked up from here). Use a folder inside your
# home directory, not the home directory itself: Claude Code asks again on every start whether to trust it.
TG_BRIDGE_WORKDIR=~/tg-sessions

# Optional ---------------------------------------------------------------
# Language of the bot's messages: en (default) or zh
TG_BRIDGE_LANG=en
# Herdr workspace (id or label) where new sessions open; default: Herdr's current workspace
HERDR_WORKSPACE=
# State, inbox for received files
TG_BRIDGE_STATE_DIR=~/.tg-bridge
# Local control port (tg-send, /health)
TG_BRIDGE_PORT=18820
# File extensions sent back automatically when a session creates them with the Write tool
TG_AUTOSEND_EXT=png,jpg,jpeg,gif,webp,svg,pdf,docx,doc,xlsx,xls,pptx,ppt,csv,zip,tar,gz,html,mp4,mov,mp3,wav,m4a
# Agent for `/new name` and topics created in the client: claude or codex (`/new codex name` picks one per topic)
TG_AGENT_KIND=claude
# Extra arguments for `claude` / `codex` in new sessions, e.g. --model opus
TG_CLAUDE_ARGS=
TG_CODEX_ARGS=
# Status heartbeat interval (seconds) and the window in which a successful poll counts as online
TG_STATUS_INTERVAL=30
TG_ONLINE_WINDOW=90
# While abnormal, stop refreshing the pinned status after this many beats with no change (a button refreshes it by hand)
TG_STATUS_PAUSE_AFTER=3
# Optional JSON files with plan limits, shown in the pinned status, /status and /sessions.
# TG_USAGE_FILE: {"five_hour":{"used_percentage":7,"resets_at":<unix s>},"seven_day":{...},"updated_at":<unix s>}
#   (Claude Code passes rate_limits to the status line command; have it write them to a file)
# TG_FABLE_USAGE_FILE: {"percent":2,"resets_at":<unix s>,"fetched_at":<unix s>}
TG_USAGE_FILE=
TG_FABLE_USAGE_FILE=
# macOS: keep the Mac from idle-sleeping while the bridge runs (closing the lid still sleeps it); 0 turns it off
TG_BRIDGE_CAFFEINATE=1
# 1 enables POST /sim for local end-to-end tests
TG_BRIDGE_SIM=0
