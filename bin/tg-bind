#!/bin/sh
# Bind the calling Claude/Codex Herdr session. Explicit --pane is useful from a normal terminal.
set -eu
PORT="${TG_BRIDGE_PORT:-18820}"
pane="${HERDR_PANE_ID:-}"
kind=""
session=""
session_explicit=false
off=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    off) off=true; shift ;;
    --pane|--kind|--session)
      [ "$#" -ge 2 ] || { echo "missing value for $1" >&2; exit 2; }
      case "$1" in --pane) pane="$2" ;; --kind) kind="$2" ;; --session) session="$2"; session_explicit=true ;; esac
      shift 2 ;;
    *) echo "usage: tg-bind [off] [--pane ID] [--kind claude|codex] [--session ID]" >&2; exit 2 ;;
  esac
done
# A caller selecting Claude must not inherit the outer Codex session's identity.
if [ -z "$kind" ] && [ -n "${CODEX_THREAD_ID:-}" ]; then kind=codex; fi
if [ "$kind" = codex ] && [ "$session_explicit" = false ]; then session="${CODEX_THREAD_ID:-}"; fi
[ -n "$pane" ] || { echo "tg-bind: HERDR_PANE_ID is not set; run inside a Herdr pane or pass --pane ID" >&2; exit 2; }
case "$kind" in ""|claude|codex) ;; *) echo "unsupported agent kind" >&2; exit 2 ;; esac
payload=$(TG_BIND_PANE="$pane" TG_BIND_KIND="$kind" TG_BIND_SESSION="$session" TG_BIND_OFF="$off" python3 -c 'import json,os; print(json.dumps({"pane":os.environ["TG_BIND_PANE"],"kind":os.environ["TG_BIND_KIND"] or None,"session":os.environ["TG_BIND_SESSION"] or None,"off":os.environ["TG_BIND_OFF"] == "true"}))')
# Omit absent kind: the bridge discovers the provider from Herdr and the transcript.
payload=$(printf '%s' "$payload" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(json.dumps({k:v for k,v in d.items() if v is not None}))')
curl -sS --fail-with-body -m 60 -X POST -H 'content-type: application/json' --data "$payload" "http://127.0.0.1:$PORT/bind" || {
  rc=$?
  [ "$rc" -eq 22 ] || echo '{"ok":false,"error":"cannot reach bridge; check tg-bridge status and local network permissions"}'
  exit "$rc"
}
echo
